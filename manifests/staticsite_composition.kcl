"""
Crossplane Composition wrapper for the staticsite composition.

This generates the Composition resource that ties together:
- The XRD (CompositeResourceDefinition) that defines the StaticSite API
- The KCL function that implements the composition logic
- The Crossplane function reference to execute the composition

This file bridges the KCL composition and Kubernetes/Crossplane integration.
"""

# Note: In a real deployment, the KCL function would be generated from staticsite.kcl
# via: kiln import and deployed as a Function resource separately.
# This template shows the structure of the Composition that uses that function.

composition = {
    apiVersion = "apiextensions.crossplane.io/v1"
    kind = "Composition"
    metadata.name = "staticsite-kcl"
    spec = {
        compositeTypeRef = {
            apiVersion = "platform.demotw.com/v1alpha1"
            kind = "StaticSite"
        }
        mode = "Pipeline"
        pipeline = [
            {
                step = "compose"
                functionRef.name = "function-kcl"
                input = {
                    apiVersion = "krm.kcl.dev/v1alpha1"
                    kind = "KCLInput"
                    spec.source = "# KCL composition code would be loaded here\n# See staticsite.kcl for the actual implementation"
                }
            },
            {
                step = "auto-ready"
                functionRef.name = "function-auto-ready"
            }
        ]
    }
}

[composition]
