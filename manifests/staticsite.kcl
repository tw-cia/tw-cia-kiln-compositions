"""
Static website composition: S3 bucket + CloudFront distribution with Origin Access Control.

This composition creates a production-ready static website by:
  - Creating a private S3 bucket
  - Blocking all public access to the bucket
  - Setting up an Origin Access Control (OAC) for secure CloudFront access
  - Creating a CloudFront distribution with caching optimized for static content
  - Creating a bucket policy that only allows CloudFront access via OAC

The site is served on CloudFront's *.cloudfront.net domain.
No custom domain or SSL certificate is composed (users can add these separately).
"""

import json
import regex

# AWS CloudFront managed cache policy ID for optimal static site caching
_CACHING_OPTIMIZED_POLICY_ID = "658327ea-f89d-4fab-a63d-7e88639e58f6"

schema StaticSiteSpec:
    """
    Configuration for a static website composition.

    Attributes:
        bucketName: Globally unique S3 bucket name. Required. Used as external-name for all resources.
        indexDocument: Root object returned for requests to /. Default: index.html
        priceClass: CloudFront price class (PriceClass_100|200|All). Default: PriceClass_100
        region: AWS region for S3 bucket. CloudFront is global. Default: us-east-1
        tags: Tags applied to bucket and distribution
    """
    bucketName: str
    indexDocument: str = "index.html"
    priceClass: str = "PriceClass_100"
    region: str = "us-east-1"
    tags?: {str: str}


schema StaticSiteStatus:
    """
    Observed state of a composed static website.

    Attributes:
        bucketArn: ARN of the S3 bucket (arn:aws:s3:::bucketname)
        bucketDomainName: S3 regional domain name used as CloudFront origin
        distributionId: CloudFront distribution ID
        distributionArn: CloudFront distribution ARN
        distributionDomainName: CloudFront distribution domain (*.cloudfront.net)
    """
    bucketArn: str
    bucketDomainName: str
    distributionId?: str
    distributionArn?: str
    distributionDomainName?: str


# Composed resource names for tracking in composition state
_BUCKET_NAME = "bucket"
_PUBLIC_ACCESS_BLOCK_NAME = "bucket-public-access-block"
_OAC_NAME = "origin-access-control"
_DISTRIBUTION_NAME = "distribution"
_BUCKET_POLICY_NAME = "bucket-policy"
_ORIGIN_ID = "s3-origin"


compose = lambda oxr, ocds -> [any] {
    spec: StaticSiteSpec = oxr.spec

    # S3 regional domain name: derived from bucket name and region, deterministic
    bucketDomainName = "${spec.bucketName}.s3.${spec.region}.amazonaws.com"

    # S3 Bucket: private, no public access
    bucket = {
        apiVersion = "s3.aws.m.upbound.io/v1beta1"
        kind = "Bucket"
        metadata.annotations = {
            "crossplane.io/external-name" = spec.bucketName
            "krm.kcl.dev/composition-resource-name" = _BUCKET_NAME
        }
        spec.forProvider = {
            region = spec.region
            tags = spec.tags or {}
        }
    }

    # S3 Bucket Public Access Block: enforce private access
    publicAccessBlock = {
        apiVersion = "s3.aws.m.upbound.io/v1beta1"
        kind = "BucketPublicAccessBlock"
        metadata.annotations = {
            "crossplane.io/external-name" = spec.bucketName
            "krm.kcl.dev/composition-resource-name" = _PUBLIC_ACCESS_BLOCK_NAME
        }
        spec.forProvider = {
            bucket = spec.bucketName
            region = spec.region
            blockPublicAcls = True
            blockPublicPolicy = True
            ignorePublicAcls = True
            restrictPublicBuckets = True
        }
    }

    # CloudFront Origin Access Control: secure S3 access from CloudFront only
    oac = {
        apiVersion = "cloudfront.aws.m.upbound.io/v1beta1"
        kind = "OriginAccessControl"
        metadata.annotations = {
            "crossplane.io/external-name" = spec.bucketName
            "krm.kcl.dev/composition-resource-name" = _OAC_NAME
        }
        spec.forProvider = {
            name = spec.bucketName
            description = "OAC for static site ${spec.bucketName}"
            originAccessControlOriginType = "s3"
            signingBehavior = "always"
            signingProtocol = "sigv4"
        }
    }

    # Observed OAC ID (required for distribution)
    observedOacAtProvider = ocds[_OAC_NAME]?.Resource?.status?.atProvider
    oacId = observedOacAtProvider?.id if observedOacAtProvider else None

    # CloudFront Distribution: global CDN with static site optimizations
    distribution = {
        apiVersion = "cloudfront.aws.m.upbound.io/v1beta1"
        kind = "Distribution"
        metadata.annotations = {
            "crossplane.io/external-name" = spec.bucketName
            "krm.kcl.dev/composition-resource-name" = _DISTRIBUTION_NAME
        }
        spec.forProvider = {
            enabled = True
            isIpv6Enabled = True
            comment = "Static site: ${spec.bucketName}"
            defaultRootObject = spec.indexDocument
            priceClass = spec.priceClass
            tags = spec.tags or {}
            origin = [{
                originId = _ORIGIN_ID
                domainName = bucketDomainName
                originAccessControlId = oacId
            }]
            defaultCacheBehavior = {
                targetOriginId = _ORIGIN_ID
                viewerProtocolPolicy = "redirect-to-https"
                allowedMethods = ["GET", "HEAD"]
                cachedMethods = ["GET", "HEAD"]
                compress = True
                cachePolicyId = _CACHING_OPTIMIZED_POLICY_ID
            }
            restrictions.geoRestriction = {
                restrictionType = "none"
            }
            viewerCertificate.cloudfrontDefaultCertificate = True
        }
    } if oacId else None

    # Observed distribution state (required for bucket policy)
    observedDistributionAtProvider = ocds[_DISTRIBUTION_NAME]?.Resource?.status?.atProvider
    distributionId = observedDistributionAtProvider?.id if observedDistributionAtProvider else None
    distributionArn = observedDistributionAtProvider?.arn if observedDistributionAtProvider else None
    distributionDomainName = observedDistributionAtProvider?.domainName if observedDistributionAtProvider else None

    # S3 Bucket Policy: allow CloudFront distribution to read objects
    bucketPolicyDocument = json.encode({
        Version = "2012-10-17"
        Statement = [{
            Sid = "AllowCloudFrontServicePrincipalReadOnly"
            Effect = "Allow"
            Principal = {Service = "cloudfront.amazonaws.com"}
            Action = "s3:GetObject"
            Resource = "arn:aws:s3:::${spec.bucketName}/*"
            Condition = {
                StringEquals = {"AWS:SourceArn" = distributionArn}
            }
        }]
    })

    bucketPolicy = {
        apiVersion = "s3.aws.m.upbound.io/v1beta1"
        kind = "BucketPolicy"
        metadata.annotations = {
            "crossplane.io/external-name" = spec.bucketName
            "krm.kcl.dev/composition-resource-name" = _BUCKET_POLICY_NAME
        }
        spec.forProvider = {
            bucket = spec.bucketName
            region = spec.region
            policy = bucketPolicyDocument
        }
    } if distributionArn else None

    # Update composite resource status with observed values
    xr = {
        apiVersion = oxr.apiVersion
        kind = oxr.kind
        metadata = oxr.metadata
        status = StaticSiteStatus {
            bucketArn = "arn:aws:s3:::${spec.bucketName}"
            bucketDomainName = bucketDomainName
            distributionId = distributionId
            distributionArn = distributionArn
            distributionDomainName = distributionDomainName
        }
    } if distributionId else None

    # Build resource list in dependency order
    baseResources = [bucket, publicAccessBlock, oac]
    withDistribution = baseResources + ([distribution] if distribution else [])
    withBucketPolicy = withDistribution + ([bucketPolicy] if bucketPolicy else [])
    withBucketPolicy + ([xr] if xr else [])
}

# Export function for use in Crossplane compositions
items = compose(option("params").oxr, option("params").ocds)
