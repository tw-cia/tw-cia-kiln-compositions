"""
CompositeResourceDefinition (XRD) for the StaticSite composition.

This defines the custom resource type that users create to trigger the composition.
When deployed to a Kubernetes cluster with Crossplane, this allows:

    kubectl apply -f - <<EOF
    apiVersion: platform.demotw.com/v1alpha1
    kind: StaticSite
    metadata:
      name: my-website
    spec:
      bucketName: my-unique-bucket
      region: us-east-1
      priceClass: PriceClass_100
    EOF

The Crossplane controller watches for StaticSite resources and runs the composition
to create the actual AWS resources.
"""

xrd = {
    apiVersion = "apiextensions.crossplane.io/v1"
    kind = "CompositeResourceDefinition"
    metadata.name = "staticsites.platform.demotw.com"
    spec = {
        group = "platform.demotw.com"
        names = {
            kind = "StaticSite"
            plural = "staticsites"
        }
        scope = "Namespaced"
        versions = [{
            name = "v1alpha1"
            served = True
            referenceable = True
            schema = {
                openAPIV3Schema = {
                    type = "object"
                    properties = {
                        spec = {
                            description = "A static website: S3 bucket behind CloudFront with Origin Access Control. Served on CloudFront's *.cloudfront.net domain."
                            type = "object"
                            properties = {
                                bucketName = {
                                    description = "Name of the S3 bucket. Must be globally unique and a valid S3 bucket name. Used as external-name for all composed resources."
                                    type = "string"
                                    minLength = 3
                                    maxLength = 63
                                }
                                indexDocument = {
                                    description = "Object CloudFront returns for requests to the root URL."
                                    type = "string"
                                    default = "index.html"
                                }
                                priceClass = {
                                    description = "CloudFront price class: PriceClass_100 (US/EU), PriceClass_200 (adds Africa/Middle East), or PriceClass_All (all regions)."
                                    type = "string"
                                    enum = ["PriceClass_100", "PriceClass_200", "PriceClass_All"]
                                    default = "PriceClass_100"
                                }
                                region = {
                                    description = "AWS region for the S3 bucket. CloudFront has no region. Defaults to us-east-1."
                                    type = "string"
                                    default = "us-east-1"
                                }
                                tags = {
                                    description = "Tags applied to the bucket and distribution."
                                    type = "object"
                                    additionalProperties = {
                                        type = "string"
                                    }
                                }
                            }
                            required = ["bucketName"]
                        }
                        status = {
                            type = "object"
                            properties = {
                                bucketArn = {
                                    description = "ARN of the composed S3 bucket (arn:aws:s3:::bucketname)."
                                    type = "string"
                                }
                                bucketDomainName = {
                                    description = "Regional domain name of the bucket, used as CloudFront origin (bucket.s3.region.amazonaws.com)."
                                    type = "string"
                                }
                                distributionId = {
                                    description = "CloudFront distribution ID (e.g., E1234567890ABC)."
                                    type = "string"
                                }
                                distributionArn = {
                                    description = "ARN of the CloudFront distribution."
                                    type = "string"
                                }
                                distributionDomainName = {
                                    description = "CloudFront distribution domain (*.cloudfront.net) where the site is served."
                                    type = "string"
                                }
                            }
                        }
                    }
                }
            }
        }]
    }
}

[xrd]
